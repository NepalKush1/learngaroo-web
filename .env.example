# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public address of the live site (used for links in emails, Stripe redirects,
# the sitemap and social-share previews).
NEXT_PUBLIC_SITE_URL=https://www.example.com.au

# ── Admin dashboard (/admin) ───────────────────────────────────────────────
ADMIN_PASSWORD=choose-a-long-unique-password
# Random secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Online payments (Stripe) ───────────────────────────────────────────────
# Without these, bookings are saved as "requested" and you arrange payment
# yourself. Use sk_test_… keys while testing.
STRIPE_SECRET_KEY=
# From Stripe Dashboard → Developers → Webhooks, endpoint:
#   https://<your-domain>/api/stripe/webhook
# Events: checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=

# ── Email (Resend) ─────────────────────────────────────────────────────────
# Without these, emails are printed to the server log instead of sent.
RESEND_API_KEY=
# Sender address on a domain you've verified in Resend.
EMAIL_FROM="Learniiz Migration & Visa Services <bookings@example.com.au>"
# Inbox that receives new booking and enquiry notifications.
NOTIFY_EMAIL=

# ── Storage ────────────────────────────────────────────────────────────────
# SQLite database file. Defaults to ./storage/learniiz.db. In production,
# point this at a persistent disk and back it up regularly.
# DATABASE_PATH=/var/data/learniiz.db
